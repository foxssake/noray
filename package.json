{
	"name": "@foxssake/noray",
	"version": "1.5.5",
	"description": "Network connection orchestrator",
	"main": "src/noray.ts",
	"type": "module",
	"bin": {
		"noray": "bin/noray.ts"
	},
	"scripts": {
		"lint": "eslint src bin",
		"test:spec": "bun test test/spec",
		"test:e2e": "bun test test/e2e | bun scripts/taplog.ts utap \"pino-pretty -c\"",
		"start": "bun bin/noray.ts | pino-pretty",
		"start:prod": "bun bin/noray.ts"
	},
	"keywords": [
		"online",
		"multiplayer",
		"orchestrator",
		"relay",
		"nat"
	],
	"author": "Tamás Gálffy",
	"license": "MIT",
	"repository": "github:foxssake/noray",
	"homepage": "https://github.com/foxssake/noray",
	"bugs": {
		"url": "https://github.com/foxssake/noray/issues"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.1",
		"eslint-config-standard": "^17.0.0",
		"eslint-plugin-import": "^2.25.2",
		"eslint-plugin-n": "^15.0.0",
		"eslint-plugin-promise": "^6.0.0",
		"pino-pretty": "^10.0.0",
		"sinon": "^22.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"utap": "^0.2.0"
	},
	"dependencies": {
		"@foxssake/trimsock-js": "^0.17.0",
		"@foxssake/trimsock-bun": "^0.17.0",
		"nanoid": "^4.0.1",
		"pino": "^8.11.0",
		"prom-client": "^14.2.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"files": [
		"src/*",
		"bin/*"
	]
}
